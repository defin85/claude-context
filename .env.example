# Claude Context Environment Variables Example
# 
# Copy this file to ~/.context/.env as a global setting, modify the values as needed
#
# Usage: cp env.example ~/.context/.env
#
# Note: This file does not work if you put it in your codebase directory (because it may conflict with the environment variables of your codebase project)

# =============================================================================
# Embedding Provider Configuration
# =============================================================================

# Embedding provider: OpenAI, VoyageAI, Gemini, Ollama, BGE_M3
EMBEDDING_PROVIDER=OpenAI

# Embedding model (provider-specific)
EMBEDDING_MODEL=text-embedding-3-small

# Legacy embedding batch size for processing (default: 100).
# INDEX_EMBEDDING_BATCH_SIZE overrides this when set.
EMBEDDING_BATCH_SIZE=100

# Separate indexing batch-size controls. Keep defaults unless benchmark artifacts
# show better wall-clock without higher retry/failure pressure.
# INDEX_EMBEDDING_BATCH_SIZE=100
# INDEX_INSERT_BATCH_SIZE=100
# Payload-safe embedding batch caps. Leave unset/auto for dense-only providers.
# BGE-M3 full uses conservative effective defaults when unset.
# INDEX_EMBEDDING_MAX_CONTENT_CHARS=auto
# INDEX_EMBEDDING_MAX_ESTIMATED_TOKENS=auto

# Maximum number of code chunks to index per codebase (default: 450000)
# Increase this for very large repositories when you accept the extra indexing time and vector database storage.
# CODE_CHUNK_LIMIT=450000

# 1C exported-configuration indexing scope profile.
# full preserves existing traversal. developer excludes documented generated or
# low-value 1C export files. minimal indexes only high-value BSL modules.
# Changing this for an existing index requires force=true.
# 1C_INDEX_SCOPE_PROFILE=full

# =============================================================================
# OpenAI Configuration
# =============================================================================

# OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI base URL (optional, for custom endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# VoyageAI Configuration
# =============================================================================

# VoyageAI API key
# VOYAGEAI_API_KEY=your-voyageai-api-key-here

# =============================================================================
# Gemini Configuration
# =============================================================================

# Google Gemini API key
# GEMINI_API_KEY=your-gemini-api-key-here

# Gemini API base URL (optional, for custom endpoints)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =============================================================================
# Ollama Configuration
# =============================================================================

# Ollama model name
# OLLAMA_MODEL=

# Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# BGE-M3 Configuration (Local/Self-hosted)
# =============================================================================

# Local BGE-M3 sidecar endpoint. Required when EMBEDDING_PROVIDER=BGE_M3.
# The sidecar must expose POST /embed and POST /embed_batch and return dense vectors,
# model-generated sparse lexical weights, and ColBERT token vectors for full mode.
# BGE_M3_ENDPOINT=http://127.0.0.1:8000

# BGE-M3 model name (default: BAAI/bge-m3)
# BGE_M3_MODEL=BAAI/bge-m3

# BGE-M3 mode: full uses dense+sparse+ColBERT; dense is explicit dense-only mode.
# BGE_M3_MODE=full

# Max first-stage dense+sparse candidates sent to ColBERT reranking.
# BGE_M3_CANDIDATE_LIMIT=100

# Max candidates returned after reranking. Defaults to the search limit.
# BGE_M3_RERANK_LIMIT=10

# Store ColBERT token vectors for full mode. Full mode requires this to stay true.
# BGE_M3_STORE_COLBERT=true

# Accelerated indexing mode. Parallel insert remains conservative by default:
# INDEX_INSERT_CONCURRENCY defaults to 1 and should be raised only after local
# Milvus safety/throughput validation.
# INDEX_ACCELERATOR_MODE=off
# INDEX_EMBEDDING_BATCH_SIZE=100
# INDEX_INSERT_BATCH_SIZE=100
# INDEX_EMBEDDING_MAX_CONTENT_CHARS=auto
# INDEX_EMBEDDING_MAX_ESTIMATED_TOKENS=auto
# INDEX_EMBEDDING_CONCURRENCY=2
# INDEX_INSERT_CONCURRENCY=1
# INDEX_INSERT_QUEUE_CAPACITY=2
# INDEX_ADAPTIVE_BACKPRESSURE=true
# INDEX_ADAPTIVE_MIN_EMBEDDING_CONCURRENCY=1
# INDEX_ADAPTIVE_HIGH_PRESSURE_THRESHOLD=1
# INDEX_ADAPTIVE_LOW_PRESSURE_THRESHOLD=0.5
# INDEX_ADAPTIVE_HEALTHY_SAMPLE_COUNT=3
# INDEX_ADAPTIVE_COOLDOWN_MS=5000
# INDEX_ADAPTIVE_INSERT_BACKLOG_THRESHOLD=2
# INDEX_ADAPTIVE_INSERT_BACKLOG_MIN_BATCHES=30
# INDEX_ADAPTIVE_INSERT_LATENCY_MS_THRESHOLD=30000
# INDEX_ADAPTIVE_RETRY_RATE_THRESHOLD=0.5
# INDEX_ADAPTIVE_RETRY_RATE_MIN_BATCHES=10
# INDEX_ADAPTIVE_REJECTED_WORKERS_THRESHOLD=1
# INDEX_ADAPTIVE_MEMORY_FREE_PERCENT_THRESHOLD=3
# INDEX_ADAPTIVE_VRAM_USAGE_LIMIT_PERCENT=90

# Max ColBERT token vectors stored per chunk. Lower values reduce Milvus row size.
# BGE_M3_COLBERT_TOKEN_LIMIT=4

# Decimal places retained for stored ColBERT vectors.
# BGE_M3_COLBERT_DECIMAL_PLACES=6

# =============================================================================
# Vector Database Configuration
# =============================================================================

# Vector database backend: milvus, lancedb, qdrant
VECTOR_DATABASE_BACKEND=qdrant

# Local LanceDB directory, used when VECTOR_DATABASE_BACKEND=lancedb.
# LANCEDB_URI=/home/your-user/.context/lancedb

# Qdrant endpoint, used when VECTOR_DATABASE_BACKEND=qdrant.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=your-qdrant-api-key

# Milvus server address. It's optional when you get Zilliz Personal API Key.
MILVUS_ADDRESS=your-zilliz-cloud-public-endpoint

# Milvus authentication token. You can refer to this guide to get Zilliz Personal API Key as your Milvus token.
# https://github.com/zilliztech/claude-context/blob/master/assets/signup_and_get_apikey.png
MILVUS_TOKEN=your-zilliz-cloud-api-key


# =============================================================================
# Code Splitter Configuration
# =============================================================================

# Code splitter type: ast, langchain
SPLITTER_TYPE=ast

# =============================================================================
# Custom File Processing Configuration
# =============================================================================

# Additional file extensions to include beyond defaults (comma-separated)
# Example: .vue,.svelte,.astro,.twig,.blade.php
# CUSTOM_EXTENSIONS=.vue,.svelte,.astro

# Additional ignore patterns to exclude files/directories (comma-separated)
# Example: temp/**,*.backup,private/**,uploads/**
# CUSTOM_IGNORE_PATTERNS=temp/**,*.backup,private/**

# Whether to use hybrid search mode. If true, it will use both dense vector and BM25; if false, it will use only dense vector search.
# HYBRID_MODE=true
